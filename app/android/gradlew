#!/usr/bin/env sh

##############################################################################
##
##  Gradle start up script for POSIX generated by Gradle.
##
##############################################################################

APP_BASE_NAME=`basename "$0"`
APP_HOME=`cd "$(dirname "$0")" >/dev/null 2>&1 && pwd -P`

JAVA_EXE=""
if [ -n "$JAVA_HOME" ] ; then
    JAVA_EXE="$JAVA_HOME/bin/java"
    if [ ! -x "$JAVA_EXE" ] ; then
        JAVA_EXE="$JAVA_HOME/jre/bin/java"
    fi
fi

if [ -z "$JAVA_EXE" ] ; then
    JAVA_EXE=`which java`
fi

if [ ! -x "$JAVA_EXE" ] ; then
    echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    exit 1
fi

WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    DISTRIBUTION_URL="https://repo1.maven.org/maven2/org/gradle/gradle-wrapper/8.3/gradle-wrapper-8.3.jar"
    echo "Downloading Gradle wrapper bootstrap..." >&2
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$DISTRIBUTION_URL" -o "$WRAPPER_JAR" || {
            echo "ERROR: Failed to download Gradle wrapper using curl." >&2
            exit 1
        }
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$DISTRIBUTION_URL" -O "$WRAPPER_JAR" || {
            echo "ERROR: Failed to download Gradle wrapper using wget." >&2
            exit 1
        }
    else
        echo "ERROR: curl or wget is required to bootstrap the Gradle wrapper." >&2
        exit 1
    }
fi

CLASSPATH=$WRAPPER_JAR

exec "$JAVA_EXE" -Xmx64m -Xms64m -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
